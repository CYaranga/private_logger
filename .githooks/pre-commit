#!/bin/bash

# Pre-commit hook for private_logger
# Runs TypeScript checks before committing

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Check if there are staged TypeScript files
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -n "$STAGED_TS_FILES" ]; then
    echo -e "${YELLOW}Checking TypeScript files...${NC}"

    # Check backend TypeScript if backend files changed
    if echo "$STAGED_TS_FILES" | grep -q "^backend/"; then
        echo "  Checking backend..."
        cd backend
        if command -v bun &> /dev/null; then
            bun tsc --noEmit 2>/dev/null || {
                echo -e "${RED}Backend TypeScript check failed${NC}"
                cd ..
                exit 1
            }
        fi
        cd ..
        echo -e "  ${GREEN}Backend: OK${NC}"
    fi

    # Check frontend TypeScript if frontend files changed
    if echo "$STAGED_TS_FILES" | grep -q "^frontend/"; then
        echo "  Checking frontend..."
        cd frontend
        if command -v bun &> /dev/null; then
            bun tsc --noEmit 2>/dev/null || {
                echo -e "${RED}Frontend TypeScript check failed${NC}"
                cd ..
                exit 1
            }
        fi
        cd ..
        echo -e "  ${GREEN}Frontend: OK${NC}"
    fi
fi

# Check for sensitive files
SENSITIVE_PATTERNS=(".env" ".dev.vars" "credentials" "secret" "password" "api_key")
for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    if git diff --cached --name-only | grep -qi "$pattern"; then
        echo -e "${RED}WARNING: You may be committing sensitive files containing '$pattern'${NC}"
        echo "Please review your staged files carefully."
        read -p "Continue anyway? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            exit 1
        fi
    fi
done

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0
